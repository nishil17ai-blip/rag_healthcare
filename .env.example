# Required: create a free Groq API key at https://console.groq.com/keys
GROQ_API_KEY=gsk_your_key_here

# Groq model used for routing, grounded answer generation, and browser search.
GROQ_MODEL=openai/gpt-oss-20b

# Free/local embedding model. Downloads once on first use.
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Exact policy document specified in the assignment.
POLICY_URL=https://www.hdfcergo.com/docs/default-source/downloads/policy-wordings/health/optima-secure-revision-pw.pdf
POLICY_PATH=data/policy/optima-secure-revision-pw.pdf

# Local Chroma vector store.
CHROMA_DIR=data/chroma
CHROMA_COLLECTION=policy_chunks

# Retrieval/chunking settings.
TOP_K=8
CHUNK_SIZE=1800
CHUNK_OVERLAP=250
